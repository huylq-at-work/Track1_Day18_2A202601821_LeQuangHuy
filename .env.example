# ==========================================================================
#  Mẫu cấu hình — COPY file này thành ".env" rồi dán API key thật vào.
#
#      copy .env.example .env        (Windows CMD)
#      cp .env.example .env          (Git Bash / PowerShell)
#
#  File ".env" đã được .gitignore bỏ qua, sẽ KHÔNG bị đẩy lên GitHub.
#  Tuyệt đối không dán key thật vào chính file .env.example này.
# ==========================================================================

# API key của OpenAI. Lấy tại https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-dan-key-that-vao-day

# (tuỳ chọn) Model dùng cho cả ba prototype. Bỏ trống thì dùng gpt-4o.
OPENAI_MODEL=gpt-4o

# (tuỳ chọn) Cổng chạy server nội bộ. Bỏ trống thì dùng 8000.
PORT=8000
